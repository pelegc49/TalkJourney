  - m_Id: 1170213644660749
    m_Localized: "\u0434\u0443\u0440\u0430\u0448\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 1170213644660751
    m_Localized: "\u043A\u043E\u0440\u0435\u043A\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1170213644660752
    m_Localized: "\u0438\u043D\u043A\u043E\u0440\u0435\u043A\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1170213644660753
    m_Localized: "\u0430\u043A\u0443\u0440\u0430\u0441\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 13000156217208832
    m_Localized: "\u0413\u0440\u0435\u0430\u0442! \u0451\u0443 \u044D\u043D\u0442\u0435\u0440\u0435\u0434
      \u0442\u0445\u0435 \u0434\u0443\u0440  \u043D\u043E\u0432 \u0442\u0440\u0438
      \u0442\u043E \u0441\u0438\u0442 \u043E\u043D \u0442\u0445\u0435 \u0441\u043E\u0444\u0430
      \u0443\u0441\u0438\u043D\u0433 \u0442\u0445\u0435 \u0442\u0440\u0438\u0433\u0435\u0440
      \u0431\u0443\u0442\u043E\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 13000156259151872
    m_Localized: "\u041D\u0435\u0440\u0435 \u044E \u043A\u0430\u043D \u0441\u0435
      \u0442\u0445\u0435 \u043A\u0443\u0435\u0441\u0448\u0435\u043D. \u041F\u0440\u0435\u0441
      \u0442\u0445\u0435 \u0430\u0440\u043E\u0432 \u0442\u043E \u043A\u043E\u043D\u0442\u0438\u043D\u0443\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 13000156259151873
    m_Localized: "\u0411\u044B \u043F\u0440\u0435\u0441\u0438\u043D\u0433 \u043E\u043D
      \u0442\u0445\u0435 \u0441\u043F\u044D\u043A\u0435\u0440 \u0431\u0443\u0442\u043E\u043D 
      \u043E\u043E\u043E \u043A\u0430\u043D \u043F\u0440\u043E\u0434\u044E\u0441\u0435
      \u0442\u0445\u0435 \u0441\u043E\u0443\u043D\u0434 \u043E\u0444 \u0432\u043D\u0430\u0442
      \u0434\u043E\u0435\u0441 \u0442\u044D \u0441\u0435\u043D\u0442\u0435\u043D\u0441\u0435
      \u0441\u043E\u0443\u043D\u0434\u0441 \u043B\u0438\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 13000156259151874
    m_Localized: "\u0422\u0445\u0438\u0441 \u0438\u0441 \u0435\u0443\u0440 \u0441\u0435\u043B\u0435\u043A\u0448\u0435\u043D\u0441 
      \u0442\u0440\u0438 \u0442\u043E \u0441\u0435\u043B\u0435\u043A\u0442 \u043E\u043D\u0435
      \u043E\u0444 \u0442\u0445\u0435 \u0431\u0443\u0431\u043B\u0435\u0441 \u0431\u044B
      \u0441\u0430\u0438\u043D\u0433 \u0438\u0442 \u0443\u0442 \u043B\u043E\u0443\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 13000156259151875
    m_Localized: "\u041D\u0435\u0440\u0435 \u044E \u043A\u0430\u043D \u0441\u0435
      \u0442\u0445\u0435 \u0432\u043E\u043B\u0443\u043C\u0435 \u043E\u0444 \u0451\u0440
      \u0432\u043E\u0439\u0441\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 20321086568263680
    m_Localized: "\u0442\u043E\u0442\u0430\u043B \u0441\u0435\u043B\u0435\u043A\u0448\u0435\u043D\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983936
    m_Localized: "\u041D\u0435\u043B\u043E! \u0412\u0443\u043B\u0434 \u0435\u044E
      \u043B\u0438\u043A\u0435 \u0442\u043E \u0434\u0440\u0438\u043D\u043A \u0441\u043E\u043C\u0435\u0442\u043D\u0438\u043D\u0433?"
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983937
    m_Localized: "\u0414\u0440\u0435\u0441 "
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983938
    m_Localized: "\u043A\u0443\u043F \u043E\u0444 \u0432\u0430\u0442\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983939
    m_Localized: "\u0428\u043E\u0435 "
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983940
    m_Localized: "\u0413\u0440\u0435\u0430\u0442! \u0412\u043D\u0430\u0442 \u0432\u0443\u043B\u0434
      \u044E \u043B\u0438\u043A\u0435 \u0442\u0443 \u044D\u0430\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983941
    m_Localized: "\u0424\u043B\u043E\u0432\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983942
    m_Localized: "\u043A\u043B\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983943
    m_Localized: "\u041F\u0438\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983944
    m_Localized: "\u0410\u0432\u0435\u0441\u043E\u043C\u0435! \u0421\u043E \u0432\u043D\u0430\u0442
      \u0438\u0441 \u0435\u0443\u0440 \u0444\u0438\u043D\u0430\u043B \u043E\u0440\u0434\u0435\u0440?"
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983945
    m_Localized: "\u0418 \u0432\u0443\u043B\u0434 \u043B\u0438\u043A\u0435 \u0430
      \u043F\u0438\u0446\u0430 \u0430\u043D\u0434 \u0430 \u043A\u0443\u043F \u043E\u0444
      \u0432\u0430\u0442\u0435\u0440 \u043F\u043B\u0435\u0430\u0441\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983946
    m_Localized: "\u042E\u0441\u0442 \u0433\u0438\u0432\u0435 \u043C\u0435 \u043C\u044B
      \u043F\u0438\u0446\u0430 \u0430\u043D\u0434 \u043C\u0438 \u0432\u0430\u0442\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983947
    m_Localized: "\u0418 \u0430\u043C \u0430 \u0434\u043E\u043A\u0442\u043E\u0440"
    m_Metadata:
      m_Items: []
