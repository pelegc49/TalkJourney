      m_Items: []
  - m_Id: 1170213644660752
    m_Localized: "\u043B\u0435\u0430 \u043D\u0438\u043A\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 1170213644660753
    m_Localized: "\u0434\u0430\u044E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 13000156217208832
    m_Localized: "\u043D\u0435\u043D\u0430\u0434\u0435\u0440! \u043D\u0438\u0445\u043D\u0430\u0441\u0435\u0442
      \u0431\u0435\u0434\u0435\u043B\u0435\u0442  \u0430\u0445\u0441\u0430\u0432
      \u043D\u0430\u0441\u0430 \u043B\u0435\u0441\u043D\u0435\u0432\u0435\u0442\u044C
      \u0430\u043B \u0445\u0438\u0441\u043F\u0430 \u0431\u0435\u044A\u0430\u043C\u0446\u0430\u044C\u043E\u0442
      \u043A\u0444\u0430\u0442\u043E\u0440 \u043D\u0430\u0445\u0430\u0434\u0435\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 13000156259151872
    m_Localized: "\u043A\u0430\u043D \u0442\u0443\u0445\u043B\u043E \u043B\u0438\u0440\u044C\u043E\u0442
      \u044D\u0442 \u043D\u0430\u0448\u0435\u044C\u0435\u043B\u0430. \u043B\u0435\u0445\u0446\u0443
      \u0430\u043B\u044C \u0445\u0430\u0445\u0430\u0442\u0446 \u043A\u0430\u0434\u0438
      \u043B\u0435\u043D\u0430\u043C\u0435\u0448\u0438\u0445!"
    m_Metadata:
      m_Items: []
  - m_Id: 13000156259151873
    m_Localized: "\u0430\u043B \u0435\u0434\u0438 \u043B\u0435\u043D\u0438\u0446\u0430
      \u0430\u043B \u043A\u0444\u0430\u0442\u043E\u0440 \u0445\u0430\u0440\u043C\u0430\u043A\u043E\u043B 
      \u0442\u0443\u0445\u043B\u043E \u043B\u0435\u043D\u0430\u043F\u0438\u043A \u044D\u0442
      \u043D\u0430\u0446\u043B\u0438\u043B \u0448\u0435\u043B \u044D\u0438\u0445
      \u043D\u0430\u043C\u0435\u0448\u043F\u0430\u0442\u044C \u043D\u0438\u0448\u043C\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 13000156259151874
    m_Localized: "\u0430\u043B\u0443 \u043D\u0438\u0432\u0445\u0438\u0440\u043E\u0442
      \u0448\u043B\u0430\u0445  \u043D\u0430\u0441\u0430 \u043B\u0438\u0432\u0445\u043E\u0440
      \u0430\u0445\u0430\u0442 \u043C\u0435\u0445\u0430\u0432\u043E\u044C\u043E\u0442
      \u0430\u043B \u0435\u0434\u0438 \u0430\u043C\u0438\u0440\u0430\u0442\u0430
      \u0432\u0435\u043A\u043E\u043B \u0440\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 13000156259151875
    m_Localized: "\u043A\u0430\u043D \u0442\u043E\u0445\u0435\u043B \u043B\u0438\u0440\u044C\u043E\u0442
      \u044D\u0442 \u043E\u0442\u0437\u043C\u0430\u0442 \u043D\u0430\u043A\u043E\u043B
      \u0448\u043B\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 20321086568263680
    m_Localized: "\u0441\u0430\u0445 \u043A\u044D\u043B \u043D\u0438\u0432\u0445\u0438\u0440\u043E\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983936
    m_Localized: "\u0448\u043B\u043E\u043C! \u0442\u0438\u0440\u0446\u0430 \u043B\u0435\u0448\u0442\u0443\u0442
      \u043C\u0438\u0448\u0435\u043D\u044C\u044E?"
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983937
    m_Localized: "\u0448\u043C\u0430\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983938
    m_Localized: "\u043A\u043E\u0441 \u043C\u0438\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983939
    m_Localized: "\u043D\u0435\u044C\u0435\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983940
    m_Localized: "\u043C\u0435\u043E\u043B\u0430! \u043C\u0435\u043D \u0442\u0438\u0440\u0446\u0430
      \u043B\u0430\u0445\u0443\u043B?"
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983941
    m_Localized: "\u0444\u0435\u0440\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983942
    m_Localized: "\u0448\u0438\u0430\u044C\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983943
    m_Localized: "\u0444\u0438\u0442\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983944
    m_Localized: "\u043C\u0435\u043E\u043B\u0430! \u0430\u0437 \u043C\u0435\u0445
      \u0445\u0430\u043D\u0430\u0437\u043C\u0430\u043D\u0430 \u0445\u0430\u0441\u043E\u0444\u0438\u0442
      \u0448\u043B\u0430\u0445?"
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983945
    m_Localized: "\u0430\u043D\u0438 \u0440\u043E\u0446\u0430 \u043F\u0438\u0446\u0430
      \u0432\u0435\u043A\u043E\u0441 \u043C\u0438\u0442 \u0431\u0435\u0431\u0430\u0445\u0448\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983946
    m_Localized: "\u0440\u0435\u043A \u0442\u0430\u043D \u043B\u0435\u0439 \u044D\u0442
      \u0445\u0430\u043F\u0438\u0446\u0430 \u0432\u0435\u0445\u0430\u043C\u0438\u043C
      \u0448\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983947
    m_Localized: "\u0430\u043D\u0438 \u0440\u043E\u0444\u044D"
    m_Metadata:
      m_Items: []
  - m_Id: 20949972205301761
    m_Localized: "\u044D\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 20949972205301762
    m_Localized: "\u043B\u0435\u0448\u0435\u043C\u0435\u0442\u043E\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 20949972205301768
    m_Localized: "\u0441\u043E\u0444\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 20952378917908480
    m_Localized: "\u0448\u043B\u043E\u043C!"
    m_Metadata:
      m_Items: []
  - m_Id: 20952378947268608
    m_Localized: "\u043D\u0430\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 20952378947268609
    m_Localized: "\u043C\u0430\u0448\u0443\u0435\u043D\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 20952378947268610
    m_Localized: "\u0433\u0430\u0434\u043E\u043B!"
    m_Metadata:
      m_Items: []
  - m_Id: 20952378947268611
    m_Localized: "\u043B\u0435\u044C\u044D\u0445\u043E\u043B?"
    m_Metadata:
      m_Items: []
  - m_Id: 20952378947268612
    m_Localized: "\u043C\u0435\u0434\u043D\u044B\u043C!"
    m_Metadata:
      m_Items: []
  - m_Id: 20952378947268613
    m_Localized: "\u0445\u0435\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 20952378947268614
    m_Localized: "\u043B\u0435\u043D\u0430\u0435\u043C\u0438\u043D?"
    m_Metadata:
      m_Items: []
  - m_Id: 21405030348877824
    m_Localized: "\u0445\u0430\u0439 \u0430\u0442\u0430! \u0430\u0442\u0430 \u0440\u043E\u0446\u0430
      \u043B\u0435\u044C\u0435\u0432\u0443\u0440? \u043C\u0435\u0445 \u0430\u0442\u0430
      \u043C\u0435\u0445\u0430\u0444\u0441\u0445?"
    m_Metadata:
      m_Items: []
  - m_Id: 21405030411792384
    m_Localized: "\u0448\u0430\u0438\u0440\u0443\u0442\u0438\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 21405030411792385
    m_Localized: "\u043C\u0435\u043A\u043B\u0435\u0434\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 21405030411792386
    m_Localized: "\u043C\u0438\u0445\u0430\u0435\u043A\u043E\u0444\u0438 \u0448\u0443\u0435\u043C\u0435\u0448"
    m_Metadata:
      m_Items: []
  - m_Id: 21405030411792387
    m_Localized: "\u0448\u0443\u043C \u0434\u0432\u0430\u0440 \u043A\u0430\u043D
      \u043B\u0435 \u0431\u0435\u0445\u0438\u043D\u0430\u043C. \u043C\u0435\u0445
      \u0430\u0442\u0430 \u0445\u043E\u043B\u0435\u0445 \u043B\u0435\u0442\u0430\u0442\u044C
      \u043B\u0435\u0439?"
    m_Metadata:
      m_Items: []
  - m_Id: 21405030411792388
    m_Localized: "\u043A\u043B\u0430\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 21405030411792389
    m_Localized: "\u0430\u043D\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 21405030411792390
    m_Localized: "\u043C\u0438\u0442\u044C\u0431\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 21405030411792391
    m_Localized: "\u0431\u0430\u0441\u0434\u0435\u0440  \u0430\u0442\u0430 \u0451\u043A\u043D\u0443\u043B
      \u043B\u0435\u043D\u0438\u043A\u0430\u043D\u0441. \u043B\u0435\u043C\u0430
      \u0430\u0442\u0430 \u043A\u0435\u043B \u043A\u0435\u0445 \u043C\u0438\u043C\u043D\u0435\u0440?"
    m_Metadata:
      m_Items: []
  - m_Id: 21405030411792392
    m_Localized: "\u0430\u043D\u0438 \u0440\u043E\u0446\u0430 \u043B\u0430\u0445\u0443\u043B
      \u044D\u0442 \u0445\u0430\u043F\u0438\u0446\u0430 \u0448\u043B\u0438 \u043A\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 21405030411792393
    m_Localized: "\u0430\u043D\u0438 \u043C\u0438\u043C\u0441\u0445 \u0446\u0440\u0438\u0445
      \u043B\u0435\u043D\u0438\u0448\u0442\u0430\u043C\u0435\u0448 \u0431\u0435\u0448\u0438\u0440\u043E\u0442\u0438\u043C
      \u0431\u0435\u0431\u0430\u0445\u0448\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 21405030411792394
    m_Localized: "\u043C\u0435\u0446\u0435\u0433 \u0445\u0430\u044A\u0430\u0432\u0438\u0440
      \u043D\u0435\u043D\u0430\u0434\u0435\u0440 \u0445\u0430\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 21405030411792395
    m_Localized: "\u043C\u0430\u0445\u0441\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 21405030411792396
    m_Localized: "\u043B\u0430\u044A\u0430\u0432\u043E\u0440?"
    m_Metadata:
      m_Items: []
  - m_Id: 21405030411792397
    m_Localized: "\u043D\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 21405030411792398
    m_Localized: "\u043C\u0435\u0445\u0430\u0444\u0441\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 21405030411792399
    m_Localized: "\u0430\u0432\u0443\u0440?"
    m_Metadata:
      m_Items: []
  - m_Id: 21405030411792400
    m_Localized: "\u0448\u0443\u043C \u0434\u0430\u0432\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 21405030411792401
    m_Localized: "\u043B\u0435\u0448\u043E\u0430\u0445\u0440\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 21405030411792402
