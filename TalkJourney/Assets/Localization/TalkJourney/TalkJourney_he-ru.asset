    m_Localized: "\u043C\u0435\u043E\u043B\u0430! \u0430\u0445\u0441\u0430\u0432 
      \u0446\u044C\u043E \u043C\u0435\u0445\u0430\u043C\u0430\u0441\u0430\u0434\u0430
      \u0432\u0435\u043B\u0435\u0445\u0443 \u0435\u0448\u0435\u0440 \u043B\u044D\u043A\u0438\u0432\u043E\u043D
