  - m_Id: 1170213644660751
    m_Localized: "\u05E7\u05D5\u05E8\u05E7\u05D8"
    m_Metadata:
      m_Items: []
  - m_Id: 1170213644660752
    m_Localized: "\u05D0\u05D9\u05E0\u05E7\u05D5\u05E8\u05E7\u05D8"
    m_Metadata:
      m_Items: []
  - m_Id: 1170213644660753
    m_Localized: "\u05D4\u05D4\u05E7\u05D5\u05E8\u05E1\u05D9"
    m_Metadata:
      m_Items: []
  - m_Id: 13000156217208832
    m_Localized: "\u05D2\u05E8\u05D9\u05D9\u05D8! \u05D9\u05D0 \u05D0\u05E0\u05D8\u05E8\u05D3
      \u05D0\u05EA\u05D4 \u05D3\u05D5\u05E8  \u05E0\u05D5\u05D0\u05D5 \u05D0\u05EA\u05E8\u05D9
      \u05EA\u05D5 \u05E1\u05D9 \u05D0\u05D5\u05DF \u05EA\u05D4 \u05E1\u05D5\u05E4\u05D4
      \u05D0\u05D5\u05E1\u05D9\u05E0\u05D2 \u05EA\u05D4 \u05D8\u05E8\u05D9\u05D2\u05E8
      \u05D1\u05D8\u05D5\u05DF."
    m_Metadata:
      m_Items: []
  - m_Id: 13000156259151872
    m_Localized: "\u05D4\u05E8\u05D9 \u05D9\u05D0 \u05DB\u05DF \u05E1\u05D9 \u05D0\u05EA\u05D4
      \u05DB\u05D5\u05E1\u05E9\u05DF. \u05E4\u05E8\u05E1 \u05D0\u05EA\u05D4 \u05D0\u05E8\u05D5\u05D5
      \u05D8\u05D5\u05E2\u05D4 \u05E7\u05D5\u05E0\u05D8\u05D9\u05E0\u05D5\u05D0\u05D9!"
    m_Metadata:
      m_Items: []
  - m_Id: 13000156259151873
    m_Localized: "\u05D1\u05D9 \u05E4\u05D9\u05E8\u05E1\u05D9\u05E0\u05D2 \u05D0\u05D5\u05DF
      \u05D0\u05EA\u05D4 \u05E1\u05E4\u05D9\u05E7\u05E8 \u05D1\u05D8\u05D5\u05DF 
      \u05D9\u05D0 \u05DB\u05DF \u05E4\u05E8\u05D5\u05D3\u05E9\u05D4 \u05D0\u05EA\u05D4
      \u05E1\u05D0\u05D5\u05E0\u05D3 \u05E2\u05D5\u05E3 \u05D5\u05D0\u05D7\u05EA
      \u05D3\u05D5\u05E1 \u05EA\u05D4 \u05E1\u05E0\u05D8\u05E0\u05E1\u05D4 \u05E1\u05D5\u05E0\u05D3\u05E1
      \u05DC\u05DA."
    m_Metadata:
      m_Items: []
  - m_Id: 13000156259151874
    m_Localized: "\u05EA\u05D7\u05E9 \u05D9\u05E9 \u05D9\u05D5\u05E8 \u05E1\u05DC\u05E7\u05E9\u05E0\u05E1 
      \u05D0\u05EA\u05E8\u05D9 \u05EA\u05D5 \u05E1\u05DC\u05E7\u05D8 \u05D0\u05D5
      \u05E2\u05D5\u05E3 \u05EA\u05D4 \u05D1\u05D0\u05D1\u05DC\u05E1 \u05D1\u05D9
      \u05E9\u05E1\u05D9\u05D9\u05E0\u05D2 \u05D9\u05D8 \u05D0\u05EA \u05DC\u05D5\u05D3."
    m_Metadata:
      m_Items: []
  - m_Id: 13000156259151875
    m_Localized: "\u05D4\u05E8\u05D9 \u05D9\u05D0 \u05DB\u05DF \u05E1\u05D9 \u05D0\u05EA\u05D4
      \u05D5\u05DC\u05D0\u05DE\u05D0 \u05E2\u05D5\u05E3 \u05D9\u05D5\u05E8 \u05D5\u05D5\u05D9\u05D9\u05E1\u05E2."
    m_Metadata:
      m_Items: []
  - m_Id: 20321086568263680
    m_Localized: "\u05EA\u05D5\u05D8\u05DC \u05E1\u05D9\u05DC\u05E7\u05E9\u05E0\u05E1"
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983936
    m_Localized: "\u05D4\u05D0\u05DC\u05D5! \u05D5\u05D5\u05DC\u05D3 \u05D9\u05D5
      \u05DC\u05DA \u05D8\u05D5 \u05D3\u05E8\u05D9\u05E0\u05E7 \u05E1\u05D5\u05DE\u05EA\u05D9\u05E0\u05D2?"
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983937
    m_Localized: "\u05D3\u05E8\u05E1 "
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983938
    m_Localized: "\u05E7\u05D5\u05E4 \u05E2\u05D5\u05E3 \u05D5\u05D0\u05EA\u05E8"
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983939
    m_Localized: "\u05E9\u05D5\u05D5\u05D4 "
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983940
    m_Localized: "\u05D2\u05E8\u05D9\u05D9\u05D8! \u05D5\u05D0\u05D7\u05EA \u05D5\u05D5\u05DC\u05D3
      \u05D9\u05D5 \u05DC\u05DA \u05D8\u05D5 \u05D0\u05EA?"
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983941
    m_Localized: "\u05E4\u05DC\u05D5\u05D5\u05D0\u05E8"
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983942
    m_Localized: "\u05E7\u05DC\u05D5\u05E7"
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983943
    m_Localized: "\u05E4\u05D9\u05E6\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983944
    m_Localized: "\u05D0\u05D5\u05E1\u05D5\u05DD! \u05E1\u05D5 \u05D5\u05D0\u05D7\u05EA
      \u05D9\u05E9 \u05D9\u05D5\u05E8 \u05E4\u05D9\u05E2\u05DC \u05D0\u05D5\u05E8\u05D3\u05E8?"
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983945
    m_Localized: "\u05D9 \u05D5\u05D5\u05DC\u05D3 \u05DC\u05DA \u05D0 \u05E4\u05D9\u05E6\u05D4
      \u05D0\u05E0\u05D3 \u05D0 \u05E7\u05D5\u05E4 \u05D0\u05D5\u05E3 \u05D5\u05D0\u05EA\u05E8
      \u05E4\u05DC\u05D9\u05E1\u05D9"
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983946
    m_Localized: "\u05D2\u05D0\u05E1\u05D8 \u05D2\u05D1\u05D9 \u05DE\u05D9 \u05D9\u05DE\u05D9
      \u05E4\u05D9\u05E6\u05D4 \u05D0\u05E0\u05D3 \u05D9\u05DE\u05D9 \u05D5\u05D0\u05EA\u05E8"
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983947
    m_Localized: "\u05D9 \u05DD \u05D0 \u05D3\u05D5\u05E7\u05D8\u05D5\u05E8"
    m_Metadata:
      m_Items: []
  - m_Id: 20949972205301761
    m_Localized: "\u05EA\u05D5"
    m_Metadata:
      m_Items: []
  - m_Id: 20949972205301762
