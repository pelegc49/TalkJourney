    m_Localized: daiuk
    m_Metadata:
      m_Items: []
  - m_Id: 13000156217208832
    m_Localized: nehader! nikhnaset bedelet, akhsav nasa leshevet al hispa be'amtza'ot
      kfator hahadek.
    m_Metadata:
      m_Items: []
  - m_Id: 13000156259151872
    m_Localized: kan tokhlu lir'ot et hashe'ela. lekhtzu al hakhatz kadi lehameshikh!
    m_Metadata:
      m_Items: []
  - m_Id: 13000156259151873
    m_Localized: al yedi lehitza al kfator harmakol, tokhlu lehapik et hatzlil shel
      eikh hameshpat nishma.
    m_Metadata:
      m_Items: []
  - m_Id: 13000156259151874
    m_Localized: alu hivkhirot shlakh, nasa livkhor akhat mehavu'ot al yedi amirata
      bekol ram.
    m_Metadata:
      m_Items: []
  - m_Id: 13000156259151875
    m_Localized: kan tokhel lir'ot et otzmat hakol shlakh.
    m_Metadata:
      m_Items: []
  - m_Id: 20321086568263680
    m_Localized: sakh kel hivkhirot
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983936
    m_Localized: shlum! tirtza leshtot mishehu?
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983937
    m_Localized: shmala
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983938
    m_Localized: kos mim
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983939
    m_Localized: ne'el
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983940
    m_Localized: meula! meh tirtza lakhul?
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983941
    m_Localized: ferah
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983942
    m_Localized: shia'on
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983943
    m_Localized: fitza
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983944
    m_Localized: meula! az meh hahazmana hasofit shlakh?
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983945
    m_Localized: ani rotza pitza vekos mim bebaksha
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983946
    m_Localized: rek tan lei et hapitza vehamim shli
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983947
    m_Localized: ani rofe
    m_Metadata:
