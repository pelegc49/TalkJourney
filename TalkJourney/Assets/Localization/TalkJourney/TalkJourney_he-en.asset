      m_Items: []
  - m_Id: 21430041763770368
    m_Localized: meula! akhsav, tz'u mehamasada velekhu yesher lekivun hashirutim.
      yesh shem bekhor she'atam tzrikhim lifgosh.
    m_Metadata:
      m_Items: []
  - m_Id: 21430041801519104
    m_Localized: mushlam! akhsav, hameshiku yesher be'uto kivun bediyuk shelav be'atam
      mehamasada, vetar'u et hanot hatekhnologya mimsh lifnehem.
