    m_Localized: Pizza
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983944
    m_Localized: Awesome! So what is your final order?
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983945
    m_Localized: I would like a pizza and a cup of water please
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983946
