    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983939
    m_Localized: 'Shoe '
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983940
    m_Localized: Great! What would you like to eat?
    m_Metadata:
      m_Items: []
  - m_Id: 20321086626983941
    m_Localized: Flower
    m_Metadata:
      m_Items: []
