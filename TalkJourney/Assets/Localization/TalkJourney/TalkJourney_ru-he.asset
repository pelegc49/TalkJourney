  - m_Id: 1170213644660748
    m_Localized: "\u05D6\u05D1\u05D0\u05E8\u05E9\u05D0\u05E0\u05D9"
    m_Metadata:
      m_Items: []
  - m_Id: 1170213644660749
    m_Localized: "\u05E4\u05E8\u05D5\u05D3\u05D5\u05DC\u05D6\u05D9\u05D8\u05DC\u05E0\u05D0\u05E1\u05D8"
    m_Metadata:
      m_Items: []
  - m_Id: 1170213644660750
    m_Localized: "\u05E4\u05D5\u05DC\u05E0\u05D9 \u05D5\u05D9\u05D1\u05D5\u05E8"
    m_Metadata:
      m_Items: []
  - m_Id: 1170213644660751
    m_Localized: "\u05E4\u05E8\u05D0\u05D1\u05D9\u05DC\u05E0\u05D9"
    m_Metadata:
      m_Items: []
  - m_Id: 1170213644660752
    m_Localized: "\u05E0\u05D1\u05E8\u05E0\u05D5"
    m_Metadata:
      m_Items: []
  - m_Id: 1170213644660753
    m_Localized: "\u05EA\u05D5\u05DB\u05E0\u05D5\u05E1\u05D9\u05D8"
    m_Metadata:
      m_Items: []
  - m_Id: 13000156217208832
    m_Localized: "\u05E2\u05D8\u05DC\u05D9\u05DB\u05E0\u05D5! \u05D9\u05D1\u05D9\u05D0
      \u05D5\u05D0\u05E9\u05DC\u05D9  \u05D8\u05E4\u05D9\u05E8\u05D5 \u05E4\u05D5\u05E4\u05E8\u05D5\u05D1\u05D9\u05D5\u05D8\u05D9
      \u05E9\u05D9\u05E1\u05D9\u05D8 \u05E0\u05D0 \u05D3\u05D9\u05D5\u05DF  \u05E0\u05E6\u05D7\u05D5
      \u05E0\u05D0 \u05DB\u05E0\u05D5\u05E4\u05E7\u05D5."
    m_Metadata:
      m_Items: []
  - m_Id: 13000156259151872
    m_Localized: "\u05D6\u05D3\u05E9 \u05D9\u05D1\u05D9\u05D0 \u05D5\u05D9\u05D3\u05D0\u05EA\u05D9
      \u05D5\u05E4\u05E8\u05D5\u05E1. \u05E0\u05D0\u05D6\u05D7\u05DE\u05EA\u05D9
      \u05E1\u05D8\u05E8\u05DC\u05DB\u05D5  \u05DB\u05D7\u05D9\u05D8\u05D5\u05D1\u05D9
      \u05E4\u05E8\u05D5\u05D3\u05D5\u05DC\u05D6\u05E9\u05D9\u05EA!"
    m_Metadata:
      m_Items: []
  - m_Id: 13000156259151873
    m_Localized: "\u05E0\u05E6\u05D7\u05D5 \u05E0\u05D0 \u05DB\u05E0\u05D5\u05E4\u05E7\u05D5
      \u05D3\u05D9\u05E0\u05DE\u05D9\u05E7\u05D4  \u05D9\u05D1\u05D9\u05D0 \u05DE\u05D5\u05D6\u05D7\u05EA
      \u05D5\u05E1\u05E4\u05D9\u05E8\u05D5\u05D6\u05D1\u05D0\u05E1\u05EA\u05D9 \u05D6\u05D1\u05D5\u05E7 
      \u05E7\u05D5\u05D8\u05D5\u05E8\u05D9 \u05E1\u05D5\u05D5\u05D8\u05D5\u05E6\u05D8\u05D5\u05D5\u05D9\u05D9\u05EA
      \u05D6\u05D1\u05D5\u05DB\u05E0\u05D0\u05D9\u05D5 \u05E4\u05E8\u05D9\u05D3\u05DC\u05E2\u05D6\u05D7\u05E0\u05D9\u05D9\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 13000156259151874
    m_Localized: "\u05D5\u05D0\u05EA \u05D5\u05D0\u05D9\u05E9\u05D9 \u05D5\u05E8\u05D9\u05D0\u05E0\u05D8\u05D9 
      \u05E4\u05E8\u05D5\u05D9\u05D6\u05E0\u05E1\u05D9\u05D9\u05D4 \u05D9\u05D2 \u05D5\u05E1\u05DC\u05D0\u05DA."
    m_Metadata:
      m_Items: []
  - m_Id: 13000156259151875
    m_Localized: "\u05D6\u05D3\u05E9 \u05D9\u05D1\u05D9\u05D0 \u05DE\u05D5\u05D6\u05D7\u05EA
      \u05E2\u05D5\u05D1\u05D3\u05EA \u05D2\u05E8\u05D5\u05DE\u05E7\u05D5\u05E9\u05D8
      \u05E1\u05D1\u05D5\u05D9\u05D0\u05D2 \u05D2\u05D5\u05DC\u05D5\u05E9\u05D0."
    m_Metadata:
      m_Items: []
  references:
    version: 2
